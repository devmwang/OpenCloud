{
    "name": "server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "run-p dev:server db:studio",
        "dev:server": "tsx watch src/index.ts",
        "db:studio": "drizzle-kit studio --config drizzle.config.ts",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
        "db:push": "drizzle-kit push --config drizzle.config.ts",
        "db:baseline": "tsx src/scripts/baseline-drizzle.ts",
        "admin:provision": "tsx src/scripts/provision-admin.ts",
        "build": "rimraf dist && tsdown src/index.ts --format esm --out-dir dist",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "rimraf dist",
        "start": "node ./dist/index.mjs"
    },
    "nodemonConfig": {
        "ignore": [
            ".git",
            "node_modules"
        ],
        "watch": [
            "src"
        ],
        "exec": "node -r tsconfig-paths/register -r ts-node/register ./src/index.ts",
        "ext": "ts, js"
    },
    "dependencies": {
        "@dotenvx/dotenvx": "^1.64.0",
        "@fastify/busboy": "^3.2.0",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/csrf-protection": "^7.1.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/jwt": "^10.0.0",
        "@fastify/multipart": "^10.0.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "^10.1.3",
        "@paralleldrive/cuid2": "^3.3.0",
        "@t3-oss/env-core": "^0.13.11",
        "argon2": "^0.44.0",
        "better-auth": "^1.6.13",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.8.5",
        "fastify-plugin": "^5.1.0",
        "file-type": "^22.0.1",
        "ipaddr.js": "^2.3.0",
        "ms": "^2.1.3",
        "pg": "^8.20.0",
        "sharp": "^0.35.3",
        "zod": "^4.4.1",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.20.0",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.2.1",
        "eslint-config-custom": "workspace:*",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "tsconfig": "workspace:*",
        "tsconfig-paths": "^4.2.0",
        "tsdown": "0.21.10",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    }
}
