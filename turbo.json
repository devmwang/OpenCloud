{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "NEXT_PUBLIC_OPENCLOUD_SERVER_URL",
        "NEXT_PUBLIC_FILE_PURGE_RETENTION_DAYS",
        "NEXT_PUBLIC_OFFICE_ONLINE_PREVIEW_ENABLED",
        "ENABLE_EXPERIMENTAL_COREPACK"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "outputs": []
        },
        "start": {
            "dependsOn": ["build"]
        }
    }
}
